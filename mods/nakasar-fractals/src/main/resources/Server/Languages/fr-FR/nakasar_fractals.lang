fractal.Cliffside.name = Falaise
items.Nakasar_Fractal_Arch_Cliffside.name = Arche : Falaise
items.Nakasar_Fractal_Arch_Cliffside.description = Un sentier taillé dans la falaise, le long d'un colosse enchaîné. Cinq sceaux à briser au marteau des cultistes, jusqu'à l'Archidevin.\n\nLe meneur l'utilise pour y envoyer le cercle.
fractal.Uncategorized.name = Inclassable
items.Nakasar_Fractal_Arch_Uncategorized.name = Arche : Inclassable
items.Nakasar_Fractal_Arch_Uncategorized.description = Des plateformes sous les harpies, une prison, un escalier mortel et un Asura qui a perdu la raison.\n\nLe meneur l'utilise pour y envoyer le cercle.
fractal.Volcanic.name = Volcanique
items.Nakasar_Fractal_Arch_Volcanic.name = Arche : Volcanique
items.Nakasar_Fractal_Arch_Volcanic.description = Des vagues de grawls, un couloir à rochers et un chaman nourri par le volcan.\n\nLe meneur l'utilise pour y envoyer le cercle.
