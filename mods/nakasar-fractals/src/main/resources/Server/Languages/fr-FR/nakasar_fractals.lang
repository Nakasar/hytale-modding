fractal.Swampland.name = Marais
items.Nakasar_Fractal_Arch_Swampland.name = Arche : Marais
items.Nakasar_Fractal_Arch_Swampland.description = Trois feux-follets à guider à travers le marais, le Moussu et Carnasse.\n\nLe meneur l'utilise pour y envoyer le cercle.
fractal.Snowblind.name = Tempête de neige
items.Nakasar_Fractal_Arch_Snowblind.name = Arche : Tempête de neige
items.Nakasar_Fractal_Arch_Snowblind.description = Un feu de camp à nourrir dans la tempête, la Source élémentaire et un chaman grawl.\n\nLe meneur l'utilise pour y envoyer le cercle.
