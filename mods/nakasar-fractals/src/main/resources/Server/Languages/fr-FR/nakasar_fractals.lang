items.Nakasar_Fractal_Cage_Cell.name = Cage de fractale (cible de l'emprisonnement)
items.PortalKey_Nakasar_Fractal.name = Fragment des Brumes
items.PortalKey_Nakasar_Fractal.description = Un éclat des Brumes, figé dans la pierre runique. Posé dans l'Ancienne passerelle, il ouvre l'Observatoire des fractales.
portal.name = Observatoire des fractales
portal.flavor = Une île suspendue dans les Brumes, d'où l'on part vers les fractales.
portal.tag.hub = Brumes
portal.tag.group = 1 à 5 joueurs
portal.objective = Harmoniser le cercle à la console de sélection et partir en fractale
items.Nakasar_Fractal_Selection_Console.name = Console de sélection
items.Nakasar_Fractal_Selection_Console.description = Utiliser : y poser le noyau d'une fractale et le diapason d'un niveau. Les deux posés, le cercle d'harmonisation s'accorde sur cette fractale.
items.Nakasar_Fractal_Resonator.name = Résonateur d'harmonisation
items.Nakasar_Fractal_Resonator.description = Utiliser (meneur) : le cercle harmonisé part pour la fractale de la console.
items.Nakasar_Fractal_Core_Distributor.name = Distributeur de noyaux
items.Nakasar_Fractal_Core_Distributor.description = Utiliser : prendre le noyau d'une fractale, gratuit.
items.Nakasar_Fractal_Level_Distributor.name = Distributeur de diapasons
items.Nakasar_Fractal_Level_Distributor.description = Utiliser : prendre le diapason d'un niveau (1 à 100), gratuit.
