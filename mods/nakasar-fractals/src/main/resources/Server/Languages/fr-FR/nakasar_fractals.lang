fractal.Cliffside.name = Falaise
items.Nakasar_Fractal_Core_Cliffside.name = Noyau : Falaise
items.Nakasar_Fractal_Core_Cliffside.description = Un sentier taillé dans la falaise, le long d'un colosse enchaîné. Cinq sceaux à briser au marteau des cultistes, jusqu'à l'Archidevin.\n\nÀ poser dans la console de sélection.
fractal.Uncategorized.name = Inclassable
items.Nakasar_Fractal_Core_Uncategorized.name = Noyau : Inclassable
items.Nakasar_Fractal_Core_Uncategorized.description = Des plateformes sous les harpies, une prison, un escalier mortel et un Asura qui a perdu la raison.\n\nÀ poser dans la console de sélection.
fractal.Volcanic.name = Volcanique
items.Nakasar_Fractal_Core_Volcanic.name = Noyau : Volcanique
items.Nakasar_Fractal_Core_Volcanic.description = Des vagues de grawls, un couloir à rochers et un chaman nourri par le volcan.\n\nÀ poser dans la console de sélection.
fractal.SolidOcean.name = Océan solide
items.Nakasar_Fractal_Core_SolidOcean.name = Noyau : Océan solide
items.Nakasar_Fractal_Core_SolidOcean.description = Des plateformes de jade au-dessus d'un océan figé, et l'Abîme de Jade.\n\nÀ poser dans la console de sélection.
fractal.Swampland.name = Marais
items.Nakasar_Fractal_Core_Swampland.name = Noyau : Marais
items.Nakasar_Fractal_Core_Swampland.description = Trois feux-follets à guider à travers le marais, le Moussu et Carnasse.\n\nÀ poser dans la console de sélection.
fractal.Snowblind.name = Tempête de neige
items.Nakasar_Fractal_Core_Snowblind.name = Noyau : Tempête de neige
items.Nakasar_Fractal_Core_Snowblind.description = Un feu de camp à nourrir dans la tempête, la Source élémentaire et un chaman grawl.\n\nÀ poser dans la console de sélection.
fractal.SilentSurf.name = Ressac silencieux
items.Nakasar_Fractal_Core_SilentSurf.name = Noyau : Ressac silencieux
items.Nakasar_Fractal_Core_SilentSurf.description = Une grotte sans fond sous la mer de jade, à traverser au grappin et au parachute, jusqu'à Kanaxai et ses Aspects.\n\nÀ poser dans la console de sélection.
fractal.SirensReef.name = Récif de la Sirène
items.Nakasar_Fractal_Core_SirensReef.name = Noyau : Récif de la Sirène
items.Nakasar_Fractal_Core_SirensReef.description = L'île du trésor maudit : Tête-de-pierre, le canon des ombres, Black Peter, un labyrinthe de trésors et l'équipage fantôme d'Arabella Crowe sur son navire.\n\nÀ poser dans la console de sélection.
fractal.Deepstone.name = Pierre-Profonde
items.Nakasar_Fractal_Core_Deepstone.name = Noyau : Pierre-Profonde
items.Nakasar_Fractal_Core_Deepstone.description = La cité naine engloutie : runes, la sentinelle et la reine des couvées, la Lumière de Deldrimor, le Minotaure des ombres, le gouffre invisible et la Voix dans les profondeurs.\n\nÀ poser dans la console de sélection.
fractal.SunquaPeak.name = Pic de Sunqua
items.Nakasar_Fractal_Core_SunquaPeak.name = Noyau : Pic de Sunqua
items.Nakasar_Fractal_Core_SunquaPeak.description = Le massif flottant d'Ai : un escalier brisé au Bond chargé, la Voix, les cascades, la Tristesse et le Marché des marées, le sentier de lave, la Fureur, puis Ai elle-même au sommet.\n\nÀ poser dans la console de sélection.
