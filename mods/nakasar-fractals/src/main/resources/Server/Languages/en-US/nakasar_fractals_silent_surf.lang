intro = Dessa: "The Silent Surf. Thess is waiting below with the survey gear."  Thess: "Grapple, parachute, black powder, flare: all yours. Jump into the crevasse, parachute open!"
gear.given = Survey gear received: grapple, parachute, black powder, flare.
gear.refilled = Leftover supplies: gear refilled.
gear.empty = Out of charges: refill at the leftover supplies of a checkpoint.
gear.noPowder = Thess: "No powder yet. I'll give you some after the spider den."
grapple.miss = The grapple finds no hold.
parachute.ground = The parachute only opens in the air.
ride.locked = Thess: "Not yet! Clear the camp first."
ward = Thess: "That was close! The Ward brings you back to the checkpoint."
checkpoint = Checkpoint: Thess's Ward will bring you back here.
cp1 = Thess: "First survey mark. Grapple to the jade platform, then the zip line. Watch out for the bats!"
cp2 = Thess: "The spider den. The brood mother won't like this."
cp2.clear = Thess: "Here's black powder. Jump on the mushrooms, then grapple the great jade stalactite."
cp3 = Thess: "Naga! They've taken the camp."
cp3.clear = Thess: "The wind cannon, then the zip line, the mushrooms and the jade pillars."
cp4 = Thess: "Dolus?! What have they done to you..."
cp4.dolus = Corrupted First Mate Dolus: "The Surf has a voice, Thess. It sings for me."
cp4.clear = Thess: "Rest, old friend. Kanaxai is below: parachute down to the arena."
fight.cleared = The camp is clear.
dread = {name}: Dread Visage! Look away!
dread.hit = You looked at the Dread Visage!
speed = {name}: Frightening Speed! Stay off marks I to V.
kanaxai.enter = Kanaxai: "You dream awake, mortals. In the Surf, I am the one who dreams."
kanaxai.thess = Thess falls to Kanaxai's scythe. Dessa: "Thess! No!"
kanaxai.storm = Rending Storm: marked players must spread out, their pools stay on the ground.
kanaxai.harrow = Harrowshot: get out of the Aspects' circles!
kanaxai.shadows = Gathering Shadows: break his defiance!
kanaxai.shadowsFail = The shadows fall: an Aspect awakens on an island.
kanaxai.tether = An Aspect tethers you: break the link before it drags you into Phantasmagoria!
kanaxai.phantasm = Phantasmagoria: an Aspect only you can see waits on island {island}. Grapple there, mushroom back.
kanaxai.cleaver = Kanaxai rises: World Cleaver! Kill the Aspects before he strikes.
kanaxai.cleaverHit = The World Cleaver falls!
kanaxai.reset = Kanaxai dissolves into the chasm.
kanaxai.victory = Kanaxai shatters: the Surf falls silent again.
title.victory = Silent Surf complete
