items.Nakasar_Fractal_Deepstone_Pit_Orb.description = The Light of Deldrimor lights it.
items.Nakasar_Fractal_Deepstone_Pit_Orb_Lit.name = Lit orb
items.Nakasar_Fractal_Deepstone_Pit_Orb_Lit.description = A checkpoint above the abyss.
items.Nakasar_Fractal_Deepstone_Rune_Glow.name = Deldrimor rune
items.Nakasar_Fractal_Deepstone_Rune_Glow.description = A dwarven rune that still glows.
