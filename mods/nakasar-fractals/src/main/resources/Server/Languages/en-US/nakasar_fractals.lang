fractal.Cliffside.name = Cliffside
items.Nakasar_Fractal_Arch_Cliffside.name = Arch: Cliffside
items.Nakasar_Fractal_Arch_Cliffside.description = A path carved into the cliff, along a chained colossus. Five seals to break with the cultists' hammer, up to the Archdiviner.\n\nThe leader uses it to send the circle there.
fractal.Uncategorized.name = Uncategorized
items.Nakasar_Fractal_Arch_Uncategorized.name = Arch: Uncategorized
items.Nakasar_Fractal_Arch_Uncategorized.description = Platforms under harpies, a prison, a deadly staircase and an Asura who lost his mind.\n\nThe leader uses it to send the circle there.
fractal.Volcanic.name = Volcanic
items.Nakasar_Fractal_Arch_Volcanic.name = Arch: Volcanic
items.Nakasar_Fractal_Arch_Volcanic.description = Waves of grawls, a boulder corridor and a shaman fed by the volcano.\n\nThe leader uses it to send the circle there.
fractal.SolidOcean.name = Solid Ocean
items.Nakasar_Fractal_Arch_SolidOcean.name = Arch: Solid Ocean
items.Nakasar_Fractal_Arch_SolidOcean.description = Jade platforms over a frozen ocean, and the Jade Maw.\n\nThe leader uses it to send the circle there.
fractal.Swampland.name = Swampland
items.Nakasar_Fractal_Arch_Swampland.name = Arch: Swampland
items.Nakasar_Fractal_Arch_Swampland.description = Three wisps to guide through the swamp, the Mossman and Bloomhunger.\n\nThe leader uses it to send the circle there.
fractal.Snowblind.name = Snowblind
items.Nakasar_Fractal_Arch_Snowblind.name = Arch: Snowblind
items.Nakasar_Fractal_Arch_Snowblind.description = A campfire to feed in the blizzard, the Elemental Source and a grawl shaman.\n\nThe leader uses it to send the circle there.
