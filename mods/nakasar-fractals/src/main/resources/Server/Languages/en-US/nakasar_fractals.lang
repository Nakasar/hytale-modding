items.PortalKey_Nakasar_Fractal.name = Mist Fragment
items.PortalKey_Nakasar_Fractal.description = A shard of the Mists, set in runestone. Placed in the Ancient Gateway, it opens the Fractal Observatory.
portal.name = Fractal Observatory
portal.flavor = An island hanging in the Mists, where fractal journeys begin.
portal.tag.hub = Mists
portal.tag.group = 1 to 5 players
portal.objective = Attune the circle at the selection console and set off for a fractal
items.Nakasar_Fractal_Selection_Console.name = Selection Console
items.Nakasar_Fractal_Selection_Console.description = Use: place a fractal core and a level tuning fork in it. With both, the attunement circle tunes to that fractal.
items.Nakasar_Fractal_Resonator.name = Attunement Resonator
items.Nakasar_Fractal_Resonator.description = Use (leader): the attuned circle leaves for the console's fractal.
items.Nakasar_Fractal_Core_Distributor.name = Core Dispenser
items.Nakasar_Fractal_Core_Distributor.description = Use: take a fractal core, free.
items.Nakasar_Fractal_Level_Distributor.name = Tuning Fork Dispenser
items.Nakasar_Fractal_Level_Distributor.description = Use: take a level tuning fork (1 to 100), free.
