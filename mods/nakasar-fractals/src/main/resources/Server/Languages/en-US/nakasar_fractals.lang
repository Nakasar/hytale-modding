fractal.Cliffside.name = Cliffside
items.Nakasar_Fractal_Core_Cliffside.name = Core: Cliffside
items.Nakasar_Fractal_Core_Cliffside.description = A path carved into the cliff, along a chained colossus. Five seals to break with the cultists' hammer, up to the Archdiviner.\n\nPlace it in the selection console.
fractal.Uncategorized.name = Uncategorized
items.Nakasar_Fractal_Core_Uncategorized.name = Core: Uncategorized
items.Nakasar_Fractal_Core_Uncategorized.description = Platforms under harpies, a prison, a deadly staircase and an Asura who lost his mind.\n\nPlace it in the selection console.
fractal.Volcanic.name = Volcanic
items.Nakasar_Fractal_Core_Volcanic.name = Core: Volcanic
items.Nakasar_Fractal_Core_Volcanic.description = Waves of grawls, a boulder corridor and a shaman fed by the volcano.\n\nPlace it in the selection console.
fractal.SolidOcean.name = Solid Ocean
items.Nakasar_Fractal_Core_SolidOcean.name = Core: Solid Ocean
items.Nakasar_Fractal_Core_SolidOcean.description = Jade platforms over a frozen ocean, and the Jade Maw.\n\nPlace it in the selection console.
fractal.Swampland.name = Swampland
items.Nakasar_Fractal_Core_Swampland.name = Core: Swampland
items.Nakasar_Fractal_Core_Swampland.description = Three wisps to guide through the swamp, the Mossman and Bloomhunger.\n\nPlace it in the selection console.
fractal.Snowblind.name = Snowblind
items.Nakasar_Fractal_Core_Snowblind.name = Core: Snowblind
items.Nakasar_Fractal_Core_Snowblind.description = A campfire to feed in the blizzard, the Elemental Source and a grawl shaman.\n\nPlace it in the selection console.
fractal.SilentSurf.name = Silent Surf
items.Nakasar_Fractal_Core_SilentSurf.name = Core: Silent Surf
items.Nakasar_Fractal_Core_SilentSurf.description = A bottomless cave beneath the jade sea, crossed by grapple and parachute, down to Kanaxai and his Aspects.\n\nPlace it in the selection console.
fractal.SirensReef.name = Siren's Reef
items.Nakasar_Fractal_Core_SirensReef.name = Core: Siren's Reef
items.Nakasar_Fractal_Core_SirensReef.description = The island of cursed treasure: Stonehead, the shadow cannon, Black Peter, a maze of treasure and Arabella Crowe's ghost crew aboard her ship.\n\nPlace it in the selection console.
fractal.Deepstone.name = Deepstone
items.Nakasar_Fractal_Core_Deepstone.name = Core: Deepstone
items.Nakasar_Fractal_Core_Deepstone.description = The sunken dwarven city: runes, the sentinel and the brood queen, the Light of Deldrimor, the shadow minotaur, the invisible pit and the Voice in the deep.\n\nPlace it in the selection console.
