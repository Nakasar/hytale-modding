portal.name = Fractal Observatory
portal.flavor = An island hanging in the Mists, where fractal journeys begin.
portal.tag.hub = Mists
portal.tag.group = 1 to 5 players
portal.objective = Form a group on the attunement circle and pick an arch
items.Nakasar_Fractal_Astrolabe_Dial.name = Astrolabe Dial
items.Nakasar_Fractal_Astrolabe_Dial.description = Use: next level. Crouch: previous level. Only the leader sets it.
items.Nakasar_Fractal_Astrolabe_Ring.name = Astrolabe Ring
items.Nakasar_Fractal_Astrolabe_Ring.description = Armillary ring of the Astrolabe.
items.Nakasar_Fractal_Harmony_Tile.name = Attunement Tile
items.Nakasar_Fractal_Harmony_Tile.description = Players standing on the circle form the group (5 at most).
items.Nakasar_Fractal_Trial_Panel.name = Training Golem Console
items.Nakasar_Fractal_Trial_Panel.description = Use: the golem replays the fractal attacks on you.
items.Nakasar_Fractal_Exit_Stone.name = Return Stone
items.Nakasar_Fractal_Exit_Stone.description = Use: back to the Observatory.
items.Nakasar_Fractal_Infusion_Altar.name = Infusion Altar
items.Nakasar_Fractal_Infusion_Altar.description = Use: your 12 infusion slots. Each infusion placed adds its agony resistance, wherever you are; removing it takes it away.
items.Nakasar_Fractal_Mist_Forge.name = Mist Crucible
items.Nakasar_Fractal_Mist_Forge.description = Fuses two identical infusions into the next one, and remakes a Mist Fragment from shards.
items.Nakasar_Fractal_Reward_Chest.name = Fractal Reward Chest
items.Nakasar_Fractal_Reward_Chest.description = Use: your reward (one per group member). Completing a fractal at your highest level unlocks the next one.
items.Nakasar_Fractal_Archivist_Counter.name = Archivist's Counter
items.Nakasar_Fractal_Archivist_Counter.description = Use: trade Mist Shards for infusions and fragments.
items.Nakasar_Fractal_Registry.name = Fractal Registry
items.Nakasar_Fractal_Registry.description = Welcome to the Observatory, traveller of the Mists.\n\n1. Step onto the attunement circle around the Astrolabe: players standing on it form the group, five at most. The first to arrive in the Observatory leads it.\n2. The leader sets the level at the Astrolabe dial (crouch to lower it).\n3. The leader uses an arch stone: the whole circle leaves for that fractal.\n\nSeason 1: Cliffside, Uncategorized, Volcanic, Solid Ocean, Swampland, Snowblind.\nThe training golem, to the west, lets you test your hits, your agony resistance and see the fractal attacks.\nTo the east, the Archivist trades Mist Shards; the Infusion Altar holds your agony resistance and the Mist Crucible fuses infusions.\nEach fractal completed at your highest level unlocks the next; the leader can only pick a level they have unlocked.\n\nFallback command: /fractale (niveau, groupe, lancer, quitter, infos).
