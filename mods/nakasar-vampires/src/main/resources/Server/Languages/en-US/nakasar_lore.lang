# Lore du Comté Vampire (notes, épitaphes, tableau de la brèche) : généré par tools/generate_lore.py
# English texts
items.Nakasar_Lore_Hunter_Orders.name = Camp orders
items.Nakasar_Lore_Hunter_Orders.description = Nobody touches the master of the manor, nor his lady.\nThey watch us pass and do not move. As long as they stay still, so do we.\nWhoever strikes one of them dooms us all: they make no distinction.
items.Nakasar_Lore_Hunter_Log.name = Hunting log, torn page
items.Nakasar_Lore_Hunter_Log.description = Third night in the County. Bertrand did not come back from the burnt farm.\nWe found his lantern, still lit. The dead had not dared come near it.\nThe white fire works. We need more oil.
items.Nakasar_Lore_Hunter_Silver.name = A note on silver
items.Nakasar_Lore_Hunter_Silver.description = Do not waste silver bolts on walking corpses: iron is enough for them.\nKeep the silver for those with fangs. It bites them twice as hard.
items.Nakasar_Lore_Hunter_Missing.name = List of the missing
items.Nakasar_Lore_Hunter_Missing.description = Bertrand: the burnt farm.\nAlix: the guard post. The cells, most likely.\nMathurin: the manor. He wanted to "talk" to the Count.\nOne does not talk to the Count.
items.Nakasar_Lore_Hunter_Pumpkins.name = Scribbled warning
items.Nakasar_Lore_Hunter_Pumpkins.description = The pumpkin fields are not fields.\nIf the ground moves under your feet, run. If a vine grabs you, cut it before it drags you under.\nFire makes them scream.
items.Nakasar_Lore_Arrival.name = To whoever crosses the rift
items.Nakasar_Lore_Arrival.description = Here you are in the County. The dead do not like you, nor do the guards.\nThe Count will watch you pass. Do not provoke him: his wrath falls on everyone present.\nOur camp burns with a white fire. Look for it.
items.Nakasar_Lore_Village_Letter.name = A letter never sent
items.Nakasar_Lore_Village_Letter.description = My dear sister,\nThe Count had the manor bell rung three evenings in a row. Nobody knows why.\nThe harvest is fine this year. Come for the pumpkin feast, we are waiting for you.
items.Nakasar_Lore_Village_Curfew.name = The bailiff's notice
items.Nakasar_Lore_Village_Curfew.description = By order of the Count: curfew from nightfall.\nDoors stay shut. Those who go out at night are no longer under His protection.
items.Nakasar_Lore_Farm_Ledger.name = Farm ledger
items.Nakasar_Lore_Farm_Ledger.description = Harvest: forty bushels.\nTithe to the manor: twenty bushels, and one vial of blood per household.\nFather Anselme says it is the price of peace.
items.Nakasar_Lore_Farm_Diary.name = A farmer's notebook
items.Nakasar_Lore_Farm_Diary.description = The pumpkins grow too fast since the earth drank the blood of the tithe.\nAt night, they move. Joseph says I am dreaming.\nJoseph has not come back from the field.
items.Nakasar_Lore_Village_Last.name = Words scratched on a door
items.Nakasar_Lore_Village_Last.description = They came back from the graveyard.\nThey knocked on our doors with our fathers' hands.\nDo not open.
items.Nakasar_Lore_Guard_Orders.name = Guard instructions
items.Nakasar_Lore_Guard_Orders.description = Anyone caught outside at night is to be taken to the cells.\nThe Captain chooses who goes up to the manor.\nAsk no questions about those who go up.
items.Nakasar_Lore_Guard_Oath.name = The guard's oath
items.Nakasar_Lore_Guard_Oath.description = I serve the Count in life\nand beyond.
items.Nakasar_Lore_Prisoner.name = Scrawled on a scrap of cloth
items.Nakasar_Lore_Prisoner.description = They caught me at the edge of the woods. The Captain says I am "reserved".\nAt night I hear singing from the manor.\nIf anyone finds this: the Captain never lets his cells out of sight.
items.Nakasar_Lore_Count_Journal.name = The Count's journal
items.Nakasar_Lore_Count_Journal.description = They come back, with their white torches and their silver. Let them come.\nI do not fight them: I watch them. Among them there is always one who ends up listening to what the blood whispers.\nThat one, I wait for.
items.Nakasar_Lore_Countess_Letter.name = The Countess's letter
items.Nakasar_Lore_Countess_Letter.description = My dear husband,\nYou are too patient with these hunters. But I grant you your wisdom: an enemy who fears you is an enemy who teaches you.\nThe altar is thirsty again. Have the next one brought up.
items.Nakasar_Lore_Servant_Rules.name = House rules
items.Nakasar_Lore_Servant_Rules.description = Never open the curtains of the Master's room.\nNever serve garlic at table.\nNever raise a hand against the Master. The last one who did took the whole village down with him.
items.Nakasar_Lore_Ritual_Page.name = Ritual page
items.Nakasar_Lore_Ritual_Page.description = Blood offered opens the door.\nBlood drunk closes it behind you.\nIn the morning, the sun will be a stranger to you.
items.Nakasar_Lore_Blood_Pact.name = The pact
items.Nakasar_Lore_Blood_Pact.description = We, the people of the County, offer the Lord the tithe of blood.\nThe Lord keeps us from the night.\nSigned with a hundred crosses.
items.Nakasar_Lore_Tower_Hunter_Orders.name = Mission orders
items.Nakasar_Lore_Tower_Hunter_Orders.description = The Alchemist of the tower is no longer to be consulted. The hamlet by the pass lost eleven souls this autumn, and all their tracks climb towards his island.\nWe bought the secret of infused silver from him. We were wrong to look away from the price.\nGo in numbers. Drink nothing he distils.\nThe Order of Hunters
items.Nakasar_Lore_Alchemist_Journal_1.name = The Alchemist's journal, page I
items.Nakasar_Lore_Alchemist_Journal_1.description = Salt fixes, sulphur burns, mercury flees. The whole Great Work lies in those three verbs.\nThose below call it magic. They are wrong. It is a recipe, and I alone know how to follow it to the end.\nThree athanors lit, and the tower breathes.
items.Nakasar_Lore_Alchemist_Journal_2.name = The Alchemist's journal, page II
items.Nakasar_Lore_Alchemist_Journal_2.description = The hunters came back. The same muddy boots, the same questions: how to make silver bite harder.\nI sold them the answer. They pay well, and they never ask what I do with their gold.\nThe greenhouse plants are hungry. They no longer eat compost.
items.Nakasar_Lore_Alchemist_Journal_3.name = The Alchemist's journal, page III
items.Nakasar_Lore_Alchemist_Journal_3.description = A servant of the Count, tonight, as pale as his master. The Count wishes to walk in the sun, and believes my stone will let him.\nI refused. The next day, three of my notebooks were missing.\nHunters steal to kill, the Count steals to live. I no longer lend my books: they defend themselves now.
items.Nakasar_Lore_Alchemist_Journal_4.name = The Alchemist's journal, page IV
items.Nakasar_Lore_Alchemist_Journal_4.description = Distilled fire, ice, lightning and root until they could stand. They obey better than my apprentices.\nThe crystal golem guards the stair. It does not sleep, it does not eat, it asks no questions.\nBut none of them truly lives. Something is missing, and I already know what.
items.Nakasar_Lore_Alchemist_Journal_5.name = The Alchemist's journal, page V
items.Nakasar_Lore_Alchemist_Journal_5.description = The beast stopped flying the day I stitched its heart. It stays on the ground, at the back of the laboratory, and drinks acid as others drink wine.\nThe dead of the hamlet carry the buckets. They do not complain.\nI call it a chimera. The hunters would call it a crime.
items.Nakasar_Lore_Alchemist_Journal_6.name = The Alchemist's journal, page VI
items.Nakasar_Lore_Alchemist_Journal_6.description = What the stone lacks is life. One life for each drop of red.\nThe hamlet by the pass has enough to finish the work. They do nothing with their lives anyway.\nIf they come for me, I will close the terrace. Let the elements decide.
items.Nakasar_Lore_Alchemist_Journal_7.name = The Alchemist's journal, last page
items.Nakasar_Lore_Alchemist_Journal_7.description = It is red. It is warm. It beats, I swear it, like a heart held in the hand.\nI made enough for everyone who climbs this far: let them take it. Let them only know what it cost.\nEleven names. I did not write them down. I should have.
items.Nakasar_Lore_Tower_Count_Letter.name = Letter with a blood seal, never opened
items.Nakasar_Lore_Tower_Count_Letter.description = Master alchemist,\nI do not ask for your science, only its fruit. One stone, a single one, and my house will shield you from the Order for as long as you live.\nI know how to wait. Do not make me wait too long.\nThe Count
items.Nakasar_Lore_Tower_Hunter_Plea.name = Letter from the Order
items.Nakasar_Lore_Tower_Hunter_Plea.description = Friend,\nOur infused silver bolts saved more lives this winter than our swords did in ten years. We owe you a great deal.\nThat is why we write instead of climbing: people are vanishing at the pass. They say you were seen there, at night.\nTell us it is not true.
items.Nakasar_Lore_Tower_Apprentice.name = An apprentice's note, folded in four
items.Nakasar_Lore_Tower_Apprentice.description = The master brought Élise back from the hamlet. He said she would help me in the laboratory.\nI have not seen her since. Tonight, the vat is redder.\nIf anyone finds this note: I left through the corridor. The gas will not stop me.
items.Nakasar_Epitaph_Anselme.name = Here lies Father Anselme
items.Nakasar_Epitaph_Anselme.description = He blessed the tithe.\nMay he rest, if he can.
items.Nakasar_Epitaph_Joseph.name = Here rests Joseph, ploughman
items.Nakasar_Epitaph_Joseph.description = Buried twice.
items.Nakasar_Epitaph_Rose.name = To our daughter Rose
items.Nakasar_Epitaph_Rose.description = Taken by the pale fever.\nIn the end she feared only daylight.
items.Nakasar_Epitaph_Morvan.name = The Morvan family
items.Nakasar_Epitaph_Morvan.description = The vault is empty.\nDo not close it again.
items.Nakasar_Epitaph_Gauvain.name = Sir Gauvain, captain of the guard
items.Nakasar_Epitaph_Gauvain.description = Faithful to the Count,\nbeyond death.
items.Nakasar_Epitaph_Nameless.name = Nameless
items.Nakasar_Epitaph_Nameless.description = A hunter. We could not carry the body away.
items.Nakasar_Contract_Board.name = Hunters' board
items.Nakasar_Contract_Board.description = We need hands. Cross the rift.\n\nBeyond it lies the County: walking dead, a guard of bones, and in the manor, those we do not name.\nSilver bites their flesh. White fire keeps them at bay.\n\nOne contract is pinned here, only one each time the rift opens: whoever takes it first heads for a County farm, and the beast guarding its barn. Place it in an ancient gateway, slay the beast, and the bounty is yours.\n\nThe Order of Hunters
