# Occult path (vampire player) — English texts
items.Ingredient_Nakasar_Blood.name = Fresh Blood
items.Ingredient_Nakasar_Blood.description = Gathered with the Vampire Kiss from a living being. Three drops and an empty vial make a blood vial at the altar.
items.Ingredient_Nakasar_Undead_Ash.name = Undead Ash
items.Ingredient_Nakasar_Undead_Ash.description = What remains of the County's zombies and skeletons. Sun veil potions are made of it.
items.Ingredient_Nakasar_Manor_Relic.name = Manor Relic
items.Ingredient_Nakasar_Manor_Relic.description = A golden reliquary from the Count's manor, guarded by its ghosts. The altar's highest rites call for it.
items.Potion_Nakasar_Blood.name = Blood Vial
items.Potion_Nakasar_Blood.description = A vampire who drinks it regains a good third of their blood. The living feel sick.
items.Potion_Nakasar_Sun_Protection_1.name = Sun Veil I
items.Potion_Nakasar_Sun_Protection_1.description = For vampires: the sun burns less (40% less) for 8 minutes.
items.Potion_Nakasar_Sun_Protection_2.name = Sun Veil II
items.Potion_Nakasar_Sun_Protection_2.description = For vampires: the sun burns much less (70% less) for 8 minutes.
items.Potion_Nakasar_Sun_Protection_3.name = Sun Veil III
items.Potion_Nakasar_Sun_Protection_3.description = For vampires: the sun has no effect at all for 3 minutes.
items.Nakasar_Ritual_Chalice.name = Chalice of Eternal Blood
items.Nakasar_Ritual_Chalice.description = Drink it near a sacrificial altar to become a vampire. Hunger, the sun and silver will rule you; the night will be your kingdom.
items.Nakasar_Purification_Censer.name = Censer of Purification
items.Nakasar_Purification_Censer.description = Light it near a sacrificial altar to drive the vampire out and live again.
items.Nakasar_Note_Vampire_Awakening.name = Note: the thirst
items.Nakasar_Note_Vampire_Awakening.description = "My heart fell silent at the last beat. The sun refuses me, bread has no taste. Only blood answers. Up at the manor, someone is smiling."
items.Nakasar_Note_Purification.name = Note: the dawn
items.Nakasar_Note_Purification.description = "The incense burned the night out of me. I am cold, I am hungry for bread. My heart beats. I think I am alive."
items.Armor_Nakasar_Occult_Hood.name = Occult Hood
items.Armor_Nakasar_Occult_Hood.description = Woven of shadow and ash. Worn by a vampire, it holds back 30% of the sun.
items.Armor_Nakasar_Occult_Mantle.name = Occult Veil
items.Armor_Nakasar_Occult_Mantle.description = A veil of shadow over the shoulders. Worn by a vampire, it holds back 25% of the sun.
items.Rune_Nakasar_BloodNova.name = Blood Nova
items.Rune_Nakasar_BloodNova.description = A wave of blood around you that wounds creatures within 5 blocks and drinks their life. Stronger in a vampire's hands.
