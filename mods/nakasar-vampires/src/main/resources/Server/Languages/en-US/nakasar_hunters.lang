contract.farm.name = Contract: the Beast of the Farm
contract.farm.flavor = "A County farm is now a charnel house. Whatever guards the barn is no farmer anymore. Bring it down." Bounty for every hunter present.
contract.farm.objective = Slay the Zombie Abomination
contract.farm.fulfilled = Contract fulfilled: the Abomination has fallen. The hunters' bounty is in your bag.
contract.pumpkin.name = Contract: the Cursed Field
contract.pumpkin.flavor = "The vines swallowed two of ours. Burn the mother of the field." Bounty for every hunter present.
contract.pumpkin.objective = Slay the Giant Pumpkin
contract.pumpkin.fulfilled = Contract fulfilled: the Giant Pumpkin is dead. The hunters' bounty is in your bag.
contract.garrison.name = Contract: the Captain's Garrison
contract.garrison.flavor = "The Captain still upholds the Count's law, and his cells are full. Break his guard." Bounty for every hunter present.
contract.garrison.objective = Slay the Guard Captain
contract.garrison.fulfilled = Contract fulfilled: the Captain has fallen. The hunters' bounty is in your bag.
