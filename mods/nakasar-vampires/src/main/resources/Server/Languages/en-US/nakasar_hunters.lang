# Vampire hunters' workbench and its runes — English texts
items.Nakasar_Hunter_Workbench.name = Vampire Hunters' Workbench
items.Nakasar_Hunter_Workbench.description = The hunters' table. Bring them specific trophies from the County to upgrade it: it grants their runes, bounty contracts, the County key and infused silver.
benchCategories.nakasar_hunter_fires = Purifying Fires
benchCategories.nakasar_hunter_runes = Hunter Runes
benchCategories.nakasar_hunter_fragments = Fragments
items.Rune_Nakasar_LightAura.name = Aura of Light
items.Rune_Nakasar_LightAura.description = Wraps you in purifying fire for a few seconds: undead, ghosts and vampires flee from you as from a purifying torch, and burn if they stay too close.
items.Rune_Nakasar_Invisibility.name = Invisibility
items.Rune_Nakasar_Invisibility.description = Makes you invisible to creatures and other players as long as you stand still (30 seconds at most). Moving or striking reveals you.
ui.abilityKeywords.Nakasar_Purify = Purification
ui.abilityKeywords.Nakasar_Stealth = Stealth
benchCategories.nakasar_hunter_weapons = Infused Weapons
benchCategories.nakasar_hunter_contracts = Contracts
items.Nakasar_Trophy_Vampire_Fang.name = Vampire Fang
items.Nakasar_Trophy_Vampire_Fang.description = Torn from a vampire spawn. The hunters want them for their workbench upgrades, contracts and infused silver.
items.Nakasar_Trophy_Abomination_Heart.name = Abomination Heart
items.Nakasar_Trophy_Abomination_Heart.description = It still beats. Elite trophy: upgrades the hunters' workbench to level 2.
items.Nakasar_Trophy_Captain_Insignia.name = Captain's Insignia
items.Nakasar_Trophy_Captain_Insignia.description = The insignia of the Count's Guard Captain. Elite trophy: with the Giant Pumpkin seed, upgrades the hunters' workbench to level 3.
items.Nakasar_Trophy_Pumpkin_Seed.name = Giant Pumpkin Seed
items.Nakasar_Trophy_Pumpkin_Seed.description = It still sprouts, with a sickly glow. Elite trophy: with the Captain's insignia, upgrades the hunters' workbench to level 3.
items.Nakasar_Bounty_Bag_Farm.name = Bounty Bag: the Beast of the Farm
items.Nakasar_Bounty_Bag_Farm.description = The hunters' bounty for the Abomination. Right-click to open: silver, rune shards.
items.Nakasar_Bounty_Bag_Pumpkin.name = Bounty Bag: the Cursed Field
items.Nakasar_Bounty_Bag_Pumpkin.description = The hunters' bounty for the Giant Pumpkin. Right-click to open: silver, rune shards, pumpkin essence.
items.Nakasar_Bounty_Bag_Garrison.name = Bounty Bag: the Captain's Garrison
items.Nakasar_Bounty_Bag_Garrison.description = The hunters' bounty for the Captain. Right-click to open: lots of silver, rune shards, a topaz.
items.Nakasar_Contract_Farm.name = Contract: the Beast of the Farm
items.Nakasar_Contract_Farm.description = An overrun farm, an Abomination to slay. Opens a bounty fragment for the whole group for 15 minutes.
items.Nakasar_Contract_Pumpkin.name = Contract: the Cursed Field
items.Nakasar_Contract_Pumpkin.description = A field where a Giant Pumpkin grows. Opens a bounty fragment for the whole group for 15 minutes.
items.Nakasar_Contract_Garrison.name = Contract: the Captain's Garrison
items.Nakasar_Contract_Garrison.description = The Guard Captain's post and its garrison. Opens a bounty fragment for the whole group for 15 minutes.
contract.tag.undead = Undead
contract.tag.elite = Elite
contract.tag.plant = Cursed plants
contract.tag.prison = Prison
contract.farm.name = Contract: the Beast of the Farm
contract.farm.flavor = "A County farm is now a charnel house. Whatever guards the barn is no farmer anymore. Bring it down." The target drops the group's bounty bag.
contract.farm.objective = Slay the Zombie Abomination
contract.farm.fulfilled = Contract fulfilled: the Abomination has fallen. Pick up the bounty bag.
contract.pumpkin.name = Contract: the Cursed Field
contract.pumpkin.flavor = "The vines swallowed two of ours. Burn the mother of the field." The target drops the group's bounty bag.
contract.pumpkin.objective = Slay the Giant Pumpkin
contract.pumpkin.fulfilled = Contract fulfilled: the Giant Pumpkin is dead. Pick up the bounty bag.
contract.garrison.name = Contract: the Captain's Garrison
contract.garrison.flavor = "The Captain still upholds the Count's law, and his cells are full. Break his guard." The target drops the group's bounty bag.
contract.garrison.objective = Slay the Guard Captain
contract.garrison.fulfilled = Contract fulfilled: the Captain has fallen. Pick up the bounty bag.
board.claimed = You take the contract from the board. It is the only one for this rift.
board.taken = This rift's contract has already been taken. Come back at the next rift.
board.full = Your bag is full: make room to take the contract.
