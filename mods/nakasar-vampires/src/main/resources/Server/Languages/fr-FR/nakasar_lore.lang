# Lore du Comté Vampire (notes, épitaphes, tableau de la brèche) : généré par tools/generate_lore.py
# textes français
items.Nakasar_Lore_Hunter_Orders.name = Ordres du camp
items.Nakasar_Lore_Hunter_Orders.description = Personne ne touche au maître du manoir, ni à sa dame.\nIls nous regardent passer et ne bougent pas. Tant qu'ils ne bougent pas, nous non plus.\nQui frappe l'un d'eux nous condamne tous : ils ne font pas de détail.
items.Nakasar_Lore_Hunter_Log.name = Journal de traque, page arrachée
items.Nakasar_Lore_Hunter_Log.description = Troisième nuit dans le Comté. Bertrand n'est pas revenu de la ferme brûlée.\nOn a retrouvé sa lanterne, encore allumée. Les morts n'avaient pas osé l'approcher.\nLe feu blanc marche. Il nous faut plus d'huile.
items.Nakasar_Lore_Hunter_Silver.name = Note sur l'argent
items.Nakasar_Lore_Hunter_Silver.description = Ne gaspillez pas les carreaux d'argent sur les cadavres qui marchent : le fer suffit pour eux.\nGardez l'argent pour ceux qui ont des crocs. Il les mord deux fois plus fort.
items.Nakasar_Lore_Hunter_Missing.name = Liste des disparus
items.Nakasar_Lore_Hunter_Missing.description = Bertrand : la ferme brûlée.\nAlix : le poste de garde. Les cellules, sans doute.\nMathurin : le manoir. Il voulait « parler » au Comte.\nOn ne parle pas au Comte.
items.Nakasar_Lore_Hunter_Pumpkins.name = Avertissement griffonné
items.Nakasar_Lore_Hunter_Pumpkins.description = Les champs de citrouilles ne sont pas des champs.\nSi la terre bouge sous vos pieds, courez. Si une vrille vous tient, coupez-la avant qu'elle ne vous tire sous terre.\nLe feu les fait hurler.
items.Nakasar_Lore_Arrival.name = À qui passe la faille
items.Nakasar_Lore_Arrival.description = Te voilà dans le Comté. Les morts ne t'aiment pas, les gardes non plus.\nLe Comte, lui, te regardera passer. Ne le provoque pas : sa colère tombe sur tous ceux qui sont là.\nNotre camp brûle d'un feu blanc. Cherche-le.
items.Nakasar_Lore_Village_Letter.name = Lettre jamais envoyée
items.Nakasar_Lore_Village_Letter.description = Ma chère sœur,\nLe Comte a fait sonner la cloche du manoir trois soirs de suite. Personne ne sait pourquoi.\nLes moissons sont belles cette année. Viens pour la fête des citrouilles, nous t'attendons.
items.Nakasar_Lore_Village_Curfew.name = Avis du bailli
items.Nakasar_Lore_Village_Curfew.description = Par ordre du Comte : couvre-feu dès la tombée du jour.\nLes portes restent closes. Ceux qui sortent la nuit ne sont plus sous Sa protection.
items.Nakasar_Lore_Farm_Ledger.name = Registre de la ferme
items.Nakasar_Lore_Farm_Ledger.description = Récolte : quarante boisseaux.\nDîme au manoir : vingt boisseaux, et une fiole de sang par foyer.\nLe père Anselme dit que c'est le prix de la paix.
items.Nakasar_Lore_Farm_Diary.name = Carnet d'une fermière
items.Nakasar_Lore_Farm_Diary.description = Les citrouilles poussent trop vite depuis que la terre a bu le sang de la dîme.\nLa nuit, elles bougent. Joseph dit que je rêve.\nJoseph n'est pas rentré du champ.
items.Nakasar_Lore_Village_Last.name = Mot gratté sur une porte
items.Nakasar_Lore_Village_Last.description = Ils sont revenus du cimetière.\nIls ont frappé à nos portes avec les mains de nos pères.\nNe leur ouvrez pas.
items.Nakasar_Lore_Guard_Orders.name = Consignes de garde
items.Nakasar_Lore_Guard_Orders.description = Toute personne surprise dehors la nuit sera conduite aux cellules.\nLe Capitaine choisit qui monte au manoir.\nNe posez pas de questions sur ceux qui montent.
items.Nakasar_Lore_Guard_Oath.name = Serment de la garde
items.Nakasar_Lore_Guard_Oath.description = Je sers le Comte de mon vivant\net au-delà.
items.Nakasar_Lore_Prisoner.name = Griffonné sur un bout de toile
items.Nakasar_Lore_Prisoner.description = Ils m'ont pris à la lisière. Le Capitaine dit que je suis « réservé ».\nLa nuit, j'entends chanter au manoir.\nSi quelqu'un trouve ceci : le Capitaine ne quitte jamais ses cellules de vue.
items.Nakasar_Lore_Count_Journal.name = Journal du Comte
items.Nakasar_Lore_Count_Journal.description = Ils reviennent, avec leurs torches blanches et leur argent. Qu'ils viennent.\nJe ne les combats pas : je les regarde. Parmi eux, il en est toujours un qui finit par écouter ce que le sang murmure.\nCelui-là, je l'attends.
items.Nakasar_Lore_Countess_Letter.name = Lettre de la Comtesse
items.Nakasar_Lore_Countess_Letter.description = Mon cher époux,\nVous êtes trop patient avec ces chasseurs. Mais je reconnais votre sagesse : un ennemi qui vous craint est un ennemi qui vous apprend.\nL'autel a encore soif. Faites monter le prochain.
items.Nakasar_Lore_Servant_Rules.name = Règles de la maison
items.Nakasar_Lore_Servant_Rules.description = Ne jamais ouvrir les rideaux de la chambre du Maître.\nNe jamais servir d'ail à table.\nNe jamais lever la main sur le Maître. Le dernier qui l'a fait a entraîné tout le village avec lui.
items.Nakasar_Lore_Ritual_Page.name = Page de rituel
items.Nakasar_Lore_Ritual_Page.description = Le sang offert ouvre la porte.\nLe sang bu la referme derrière toi.\nAu matin, le soleil te sera étranger.
items.Nakasar_Lore_Blood_Pact.name = Le pacte
items.Nakasar_Lore_Blood_Pact.description = Nous, gens du Comté, offrons au Seigneur la dîme du sang.\nLe Seigneur nous garde de la nuit.\nSigné de cent croix.
items.Nakasar_Lore_Tower_Hunter_Orders.name = Ordre de mission
items.Nakasar_Lore_Tower_Hunter_Orders.description = L'Alchimiste de la tour ne sera plus consulté. Le hameau du col a perdu onze âmes cet automne, et leurs traces montent toutes vers son île.\nNous lui avons acheté le secret de l'argent infusé. Nous avons eu tort de fermer les yeux sur le prix.\nAllez-y à plusieurs. Ne buvez rien de ce qu'il distille.\nL'Ordre des chasseurs
items.Nakasar_Lore_Alchemist_Journal_1.name = Journal de l'Alchimiste, page I
items.Nakasar_Lore_Alchemist_Journal_1.description = Le sel fixe, le soufre brûle, le mercure fuit. Tout le Grand Œuvre tient dans ces trois verbes.\nCeux d'en bas appellent cela de la magie. Ils ont tort. C'est une recette, et je suis le seul à savoir la suivre jusqu'au bout.\nTrois athanors allumés, et la tour respire.
items.Nakasar_Lore_Alchemist_Journal_2.name = Journal de l'Alchimiste, page II
items.Nakasar_Lore_Alchemist_Journal_2.description = Les chasseurs sont revenus. Toujours les mêmes bottes boueuses, les mêmes questions : comment faire mordre l'argent plus fort.\nJe leur ai vendu la réponse. Ils paient bien, et ils ne demandent jamais ce que j'en fais, de leur or.\nLes plantes de la serre ont faim. Elles ne mangent plus de terreau.
items.Nakasar_Lore_Alchemist_Journal_3.name = Journal de l'Alchimiste, page III
items.Nakasar_Lore_Alchemist_Journal_3.description = Un serviteur du Comte, cette nuit, pâle comme son maître. Le Comte voudrait marcher au soleil, et il croit que ma pierre le lui permettra.\nJ'ai refusé. Le lendemain, trois de mes cahiers manquaient.\nLes chasseurs volent pour tuer, le Comte vole pour vivre. Je ne prête plus mes livres : ils se défendent seuls, à présent.
items.Nakasar_Lore_Alchemist_Journal_4.name = Journal de l'Alchimiste, page IV
items.Nakasar_Lore_Alchemist_Journal_4.description = Distillé le feu, la glace, la foudre et la racine jusqu'à ce qu'ils tiennent debout. Ils obéissent mieux que mes apprentis.\nLe golem de cristal garde l'escalier. Il ne dort pas, il ne mange pas, il ne pose pas de questions.\nMais aucun ne vit vraiment. Il manque quelque chose, et je sais déjà quoi.
items.Nakasar_Lore_Alchemist_Journal_5.name = Journal de l'Alchimiste, page V
items.Nakasar_Lore_Alchemist_Journal_5.description = La bête a cessé de voler le jour où je lui ai cousu le cœur. Elle reste au sol, au fond du laboratoire, et elle boit l'acide comme d'autres boivent du vin.\nLes morts du hameau portent les seaux. Ils ne se plaignent pas.\nJ'appelle cela une chimère. Les chasseurs appelleraient cela un crime.
items.Nakasar_Lore_Alchemist_Journal_6.name = Journal de l'Alchimiste, page VI
items.Nakasar_Lore_Alchemist_Journal_6.description = Ce qui manque à la pierre, c'est la vie. Une vie par goutte de rouge.\nLe hameau du col en a assez pour finir l'œuvre. Ils ne savent rien faire de leurs vies, de toute façon.\nSi l'on vient me chercher, je fermerai la terrasse. Que les éléments décident.
items.Nakasar_Lore_Alchemist_Journal_7.name = Journal de l'Alchimiste, dernière page
items.Nakasar_Lore_Alchemist_Journal_7.description = Elle est rouge. Elle est chaude. Elle bat, je le jure, comme un cœur qu'on tient dans la main.\nJ'en ai fait assez pour tous ceux qui monteront jusqu'ici : qu'ils la prennent. Qu'ils sachent seulement ce qu'elle a coûté.\nOnze noms. Je ne les ai pas écrits. J'aurais dû.
items.Nakasar_Lore_Tower_Count_Letter.name = Lettre au cachet de sang, jamais ouverte
items.Nakasar_Lore_Tower_Count_Letter.description = Maître alchimiste,\nJe ne vous demande pas votre science, seulement son fruit. Une pierre, une seule, et ma maison vous protégera de l'Ordre aussi longtemps que vous vivrez.\nJe sais attendre. Ne me faites pas attendre trop longtemps.\nLe Comte
items.Nakasar_Lore_Tower_Hunter_Plea.name = Lettre de l'Ordre
items.Nakasar_Lore_Tower_Hunter_Plea.description = Ami,\nNos carreaux d'argent infusé ont sauvé plus de vies cet hiver que nos épées en dix ans. Nous vous en devons beaucoup.\nC'est pourquoi nous vous écrivons au lieu de monter : des gens disparaissent au col. On dit qu'on vous a vu là-bas, la nuit.\nDites-nous que c'est faux.
items.Nakasar_Lore_Tower_Apprentice.name = Mot d'un apprenti, plié en quatre
items.Nakasar_Lore_Tower_Apprentice.description = Le maître a ramené Élise du hameau. Il a dit qu'elle allait m'aider au laboratoire.\nJe ne l'ai pas revue. Ce soir, la cuve est plus rouge.\nSi quelqu'un trouve ce mot : je suis parti par le couloir. Le gaz ne m'arrêtera pas.
items.Nakasar_Epitaph_Anselme.name = Ci-gît le père Anselme
items.Nakasar_Epitaph_Anselme.description = Il a béni la dîme.\nQu'il repose, s'il le peut.
items.Nakasar_Epitaph_Joseph.name = Ici repose Joseph, laboureur
items.Nakasar_Epitaph_Joseph.description = Enterré deux fois.
items.Nakasar_Epitaph_Rose.name = À notre fille Rose
items.Nakasar_Epitaph_Rose.description = Emportée par la fièvre pâle.\nElle ne craignait plus que la lumière du jour.
items.Nakasar_Epitaph_Morvan.name = Famille Morvan
items.Nakasar_Epitaph_Morvan.description = Le caveau est vide.\nNe le refermez pas.
items.Nakasar_Epitaph_Gauvain.name = Sire Gauvain, capitaine de la garde
items.Nakasar_Epitaph_Gauvain.description = Fidèle au Comte,\npar-delà la mort.
items.Nakasar_Epitaph_Nameless.name = Sans nom
items.Nakasar_Epitaph_Nameless.description = Un chasseur. Nous n'avons pas pu emporter le corps.
items.Nakasar_Contract_Board.name = Tableau des chasseurs
items.Nakasar_Contract_Board.description = Nous cherchons des bras. Passez la faille.\n\nDe l'autre côté s'étend le Comté : des morts qui marchent, une garde d'os, et au manoir, ceux qu'on ne nomme pas.\nL'argent mord leur chair. Le feu blanc les tient à distance.\n\nUn contrat est épinglé ici, un seul par passage de la faille : le premier qui le prend part pour une ferme du Comté, et la bête qui garde sa grange. Pose-le dans une passerelle ancienne, abats-la, et la prime est à toi.\n\nL'Ordre des chasseurs
