# Établi des chasseurs de vampires et ses runes — textes français
items.Nakasar_Hunter_Workbench.name = Établi des chasseurs de vampires
items.Nakasar_Hunter_Workbench.description = La table des chasseurs. Rapportez-leur des trophées précis du Comté pour la faire monter : elle donne leurs runes, leurs contrats de primes, la clé du Comté et l'argent infusé.
benchCategories.nakasar_hunter_fires = Feux purificateurs
benchCategories.nakasar_hunter_runes = Runes de chasseur
benchCategories.nakasar_hunter_fragments = Fragments
items.Rune_Nakasar_LightAura.name = Aura de lumière
items.Rune_Nakasar_LightAura.description = Vous enveloppe de feu purificateur pendant quelques secondes : morts-vivants, fantômes et vampires vous fuient comme une torche de purification, et brûlent s'ils restent trop près.
items.Rune_Nakasar_Invisibility.name = Invisibilité
items.Rune_Nakasar_Invisibility.description = Vous rend invisible aux créatures et aux autres joueurs tant que vous restez immobile (30 secondes au plus). Bouger ou frapper vous révèle.
ui.abilityKeywords.Nakasar_Purify = Purification
ui.abilityKeywords.Nakasar_Stealth = Discrétion
benchCategories.nakasar_hunter_weapons = Armes infusées
benchCategories.nakasar_hunter_contracts = Contrats
items.Nakasar_Trophy_Vampire_Fang.name = Croc de vampire
items.Nakasar_Trophy_Vampire_Fang.description = Arraché à un rejeton. Les chasseurs en demandent pour monter leur établi, leurs contrats et l'argent infusé.
items.Nakasar_Trophy_Abomination_Heart.name = Cœur d'Abomination
items.Nakasar_Trophy_Abomination_Heart.description = Il bat encore. Trophée d'élite : fait passer l'établi des chasseurs au niveau 2.
items.Nakasar_Trophy_Captain_Insignia.name = Insigne du Capitaine
items.Nakasar_Trophy_Captain_Insignia.description = L'insigne du Capitaine de la garde du Comte. Trophée d'élite : avec la graine de la Citrouille géante, fait passer l'établi des chasseurs au niveau 3.
items.Nakasar_Trophy_Pumpkin_Seed.name = Graine de la Citrouille géante
items.Nakasar_Trophy_Pumpkin_Seed.description = Elle germe encore, d'une lueur maladive. Trophée d'élite : avec l'insigne du Capitaine, fait passer l'établi des chasseurs au niveau 3.
items.Nakasar_Bounty_Bag_Farm.name = Sac de prime : la Bête de la ferme
items.Nakasar_Bounty_Bag_Farm.description = La prime des chasseurs pour l'Abomination. Clic droit pour l'ouvrir : argent, éclats de rune.
items.Nakasar_Bounty_Bag_Pumpkin.name = Sac de prime : le Champ maudit
items.Nakasar_Bounty_Bag_Pumpkin.description = La prime des chasseurs pour la Citrouille géante. Clic droit pour l'ouvrir : argent, éclats de rune, essence de citrouille.
items.Nakasar_Bounty_Bag_Garrison.name = Sac de prime : la Garnison du Capitaine
items.Nakasar_Bounty_Bag_Garrison.description = La prime des chasseurs pour le Capitaine. Clic droit pour l'ouvrir : beaucoup d'argent, éclats de rune, une topaze.
items.Nakasar_Contract_Farm.name = Contrat : la Bête de la ferme
items.Nakasar_Contract_Farm.description = Une ferme envahie, une Abomination à abattre. Ouvre un fragment de prime pour tout le groupe pendant 15 minutes.
items.Nakasar_Contract_Pumpkin.name = Contrat : le Champ maudit
items.Nakasar_Contract_Pumpkin.description = Un champ où pousse une Citrouille géante. Ouvre un fragment de prime pour tout le groupe pendant 15 minutes.
items.Nakasar_Contract_Garrison.name = Contrat : la Garnison du Capitaine
items.Nakasar_Contract_Garrison.description = Le poste du Capitaine de la garde et sa garnison. Ouvre un fragment de prime pour tout le groupe pendant 15 minutes.
contract.tag.undead = Morts-vivants
contract.tag.elite = Élite
contract.tag.plant = Plantes maudites
contract.farm.name = Contrat : la Bête de la ferme
contract.farm.flavor = « Une ferme du Comté n'est plus qu'un charnier. Ce qui garde la grange n'a plus rien d'un fermier. »
contract.farm.objective = Abattre l'Abomination zombie
contract.farm.fulfilled = Contrat rempli : l'Abomination est tombée. Ramassez le sac de prime.
contract.pumpkin.name = Contrat : le Champ maudit
contract.pumpkin.flavor = « Les vrilles ont avalé deux des nôtres. Quelque chose pousse au cœur de ce champ. »
contract.pumpkin.objective = Abattre la Citrouille géante
contract.pumpkin.fulfilled = Contrat rempli : la Citrouille géante est morte. Ramassez le sac de prime.
contract.garrison.name = Contrat : la Garnison du Capitaine
contract.garrison.flavor = « Le Capitaine tient encore la loi du Comte, et ses cellules sont pleines. »
contract.garrison.objective = Abattre le Capitaine de la garde
contract.garrison.fulfilled = Contrat rempli : le Capitaine est tombé. Ramassez le sac de prime.
board.claimed = Vous prenez le contrat du tableau. C'est le seul de cette brèche.
board.taken = Le contrat de cette brèche a déjà été pris. Revenez à la prochaine brèche.
board.full = Votre sac est plein : faites de la place pour prendre le contrat.
items.Nakasar_Trophy_Armor_Core.name = Cœur de l'armure enchantée
items.Nakasar_Trophy_Armor_Core.description = La cage runique qui animait l'armure enchantée des cryptes. Trophée d'élite.
items.Nakasar_Trophy_Spectral_Shroud.name = Suaire du Spectre
items.Nakasar_Trophy_Spectral_Shroud.description = Le linceul glacé du Spectre, encore traversé de lueurs. Trophée d'élite.
items.Nakasar_Trophy_Codex_Clasp.name = Fermoir du Codex
items.Nakasar_Trophy_Codex_Clasp.description = Le fermoir d'or qui scellait le Codex vivant. Son œil s'ouvre encore parfois. Trophée d'élite.
items.Nakasar_Trophy_Chimera_Heart.name = Cœur de chimère
items.Nakasar_Trophy_Chimera_Heart.description = Un cœur rapiécé de plusieurs bêtes, encore relié à un tube de liquide vert. Il bat à contretemps. Trophée d'élite.
items.Nakasar_Trophy_Alchemist_Mask.name = Masque de l'Alchimiste
items.Nakasar_Trophy_Alchemist_Mask.description = Le masque de cuir à long bec de l'Alchimiste. Ses verres violets gardent une lueur, comme si quelqu'un regardait encore au travers. Trophée de boss.
items.Nakasar_Bounty_Bag_Crypt.name = Sac de prime : le Gardien de la crypte
items.Nakasar_Bounty_Bag_Crypt.description = La prime des chasseurs pour l'armure enchantée. Clic droit pour l'ouvrir : argent, éclats de rune, lingots de fer, parfois un saphir.
items.Nakasar_Bounty_Bag_Castle.name = Sac de prime : le Spectre du château
items.Nakasar_Bounty_Bag_Castle.description = La prime des chasseurs pour le Spectre. Clic droit pour l'ouvrir : beaucoup d'argent, éclats de rune, une relique du manoir, parfois des saphirs.
items.Nakasar_Contract_Crypt.name = Contrat : le Gardien de la crypte
items.Nakasar_Contract_Crypt.description = Une crypte du Comté et son gardien. Ouvre un fragment de prime pour tout le groupe pendant 15 minutes.
items.Nakasar_Contract_Castle.name = Contrat : le Spectre du château
items.Nakasar_Contract_Castle.description = Un château hanté et son Spectre. Ouvre un fragment de prime pour tout le groupe pendant 15 minutes.
contract.tag.construct = Construction animée
contract.crypt.name = Contrat : le Gardien de la crypte
contract.crypt.flavor = « Dans le sous-sol de cette crypte, quelque chose veille encore. »
contract.crypt.objective = Abattre l'armure enchantée
contract.crypt.fulfilled = Contrat rempli : l'armure enchantée s'est effondrée. Ramassez le sac de prime.
contract.castle.name = Contrat : le Spectre du château
contract.castle.flavor = « Un Spectre hante ces ruines. Personne n'en est revenu. »
contract.castle.objective = Abattre le Spectre
contract.castle.fulfilled = Contrat rempli : le Spectre s'est dissipé. Ramassez le sac de prime.
