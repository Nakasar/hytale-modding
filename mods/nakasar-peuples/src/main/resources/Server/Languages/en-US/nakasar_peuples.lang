items.Nakasar_Peuples_Banner_Trork.description = This is how Trorks mark their ground.
marker.Trork = Trork camp
items.Nakasar_Peuples_Favor_Trork.name = Trophy tooth
items.Nakasar_Peuples_Favor_Trork.description = The Trorks' favour: a Trork only gives it to someone who earned their respect.
items.Nakasar_Peuples_Favor_Klops.name = Klops cog
items.Nakasar_Peuples_Favor_Klops.description = Klops count in cogs. Their wandering trader takes them anywhere.
items.Nakasar_Peuples_Klops_Parcel.name = Klops parcel
items.Nakasar_Peuples_Klops_Parcel.description = A tied-up bundle. The Klops said who it is for: /village klops to remember.
