$C = "../../../Common.ui";

@OptionTitleStyle = LabelStyle(FontSize: 17, TextColor: #e8c46a, RenderBold: true);
@OptionDetailStyle = LabelStyle(FontSize: 14, TextColor: #96a9be, Wrap: true);
@OptionCondStyle = LabelStyle(FontSize: 14, TextColor: #c8d2dc);

@OptionRow = Group {
  LayoutMode: Left;
  Anchor: (Height: 78, Bottom: 6);
  Padding: (Full: 8);
  Background: (Color: #0c151e(0.45));
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 820, Height: 640);

    #Title {
      Label #PageTitle {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Where {
        Anchor: (Height: 26, Bottom: 8);
        Style: (...$C.@SubtitleStyle);
      }

      @OptionRow #Option0 {
        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Label #Name0 { Anchor: (Height: 22); Style: @OptionTitleStyle; }
          Label #Desc0 { Anchor: (Height: 20); Style: @OptionDetailStyle; }
          Label #Cond0 { Anchor: (Height: 20); Style: @OptionCondStyle; }
        }
        $C.@SmallSecondaryTextButton #Choose0 { @Text = ""; @Anchor = Anchor(Width: 150); }
      }

      @OptionRow #Option1 {
        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Label #Name1 { Anchor: (Height: 22); Style: @OptionTitleStyle; }
          Label #Desc1 { Anchor: (Height: 20); Style: @OptionDetailStyle; }
          Label #Cond1 { Anchor: (Height: 20); Style: @OptionCondStyle; }
        }
        $C.@SmallSecondaryTextButton #Choose1 { @Text = ""; @Anchor = Anchor(Width: 150); }
      }

      @OptionRow #Option2 {
        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Label #Name2 { Anchor: (Height: 22); Style: @OptionTitleStyle; }
          Label #Desc2 { Anchor: (Height: 20); Style: @OptionDetailStyle; }
          Label #Cond2 { Anchor: (Height: 20); Style: @OptionCondStyle; }
        }
        $C.@SmallSecondaryTextButton #Choose2 { @Text = ""; @Anchor = Anchor(Width: 150); }
      }

      @OptionRow #Option3 {
        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Label #Name3 { Anchor: (Height: 22); Style: @OptionTitleStyle; }
          Label #Desc3 { Anchor: (Height: 20); Style: @OptionDetailStyle; }
          Label #Cond3 { Anchor: (Height: 20); Style: @OptionCondStyle; }
        }
        $C.@SmallSecondaryTextButton #Choose3 { @Text = ""; @Anchor = Anchor(Width: 150); }
      }

      @OptionRow #Option4 {
        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Label #Name4 { Anchor: (Height: 22); Style: @OptionTitleStyle; }
          Label #Desc4 { Anchor: (Height: 20); Style: @OptionDetailStyle; }
          Label #Cond4 { Anchor: (Height: 20); Style: @OptionCondStyle; }
        }
        $C.@SmallSecondaryTextButton #Choose4 { @Text = ""; @Anchor = Anchor(Width: 150); }
      }

      Label #Footer {
        Anchor: (Height: 22, Top: 4);
        Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 8);

        $C.@TextButton #Found { @Text = ""; @Anchor = Anchor(Right: 8, MinWidth: 220); }
        $C.@SecondaryTextButton #Cancel { @Text = ""; @Anchor = Anchor(MinWidth: 160); }
      }
    }
  }
}

$C.@BackButton {}
