$C = "../../../Common.ui";

// Généré par tools/generate_workshop_ui.py (thème neutre) : ne pas modifier à la main.

@Accent = #7a9cc6;
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1040, Height: 800);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Visible: false; }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #b4c8c9); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 14);
      Label #Intro { Anchor: (Height: 40, Bottom: 10); Style: @Body; Text: ""; }
      Group #Plots {
        LayoutMode: Left;
        Anchor: (Height: 170);
        Group #Plot0 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 14);
          Padding: (Horizontal: 16, Vertical: 12);
          Background: (Color: #1d2c40(0.75));
          Group #PlotStripe0 { Anchor: (Height: 3, Bottom: 10); Background: (Color: #7a9cc6(0.6)); }
          Label #PlotName0 { Anchor: (Height: 24); Style: (FontSize: 17, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #7a9cc6); Text: ""; }
          Label #PlotState0 { Anchor: (Top: 6); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 32);
            $C.@SmallSecondaryTextButton #PlotSelect0 { @Text = ""; @Anchor = Anchor(Width: 200, Height: 32, Right: 10); }
            $C.@SmallSecondaryTextButton #PlotAction0 { @Text = ""; @Anchor = Anchor(Width: 240, Height: 32); }
          }
        }
        Group #Plot1 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 0);
          Padding: (Horizontal: 16, Vertical: 12);
          Background: (Color: #1d2c40(0.75));
          Group #PlotStripe1 { Anchor: (Height: 3, Bottom: 10); Background: (Color: #7a9cc6(0.6)); }
          Label #PlotName1 { Anchor: (Height: 24); Style: (FontSize: 17, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #7a9cc6); Text: ""; }
          Label #PlotState1 { Anchor: (Top: 6); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 32);
            $C.@SmallSecondaryTextButton #PlotSelect1 { @Text = ""; @Anchor = Anchor(Width: 200, Height: 32, Right: 10); }
            $C.@SmallSecondaryTextButton #PlotAction1 { @Text = ""; @Anchor = Anchor(Width: 240, Height: 32); }
          }
        }
      }
      Label #CatalogHeader { Anchor: (Height: 24, Top: 14, Bottom: 6); Style: (FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #b4c8c9); Text: ""; }
      Group #Catalog {
        LayoutMode: Top;
        FlexWeight: 1;
        Group #Proj0 {
          LayoutMode: Left;
          Anchor: (Height: 70, Bottom: 6);
          Padding: (Horizontal: 12, Vertical: 6);
          Background: (Color: #1d2c40(0.55));
          Group {
            LayoutMode: Full;
            Anchor: (Width: 56, Height: 56, Right: 12);
            Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
            ItemIcon #ProjIcon0 { Anchor: (Full: 7); ShowItemTooltip: true; }
          }
          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Label #ProjName0 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #7a9cc6); Text: ""; }
            Label #ProjLine0 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
          }
          $C.@SmallSecondaryTextButton #ProjChoose0 { @Text = ""; @Anchor = Anchor(Width: 200, Height: 32, Left: 12); }
        }
        Group #Proj1 {
          LayoutMode: Left;
          Anchor: (Height: 70, Bottom: 6);
          Padding: (Horizontal: 12, Vertical: 6);
          Background: (Color: #1d2c40(0.55));
          Group {
            LayoutMode: Full;
            Anchor: (Width: 56, Height: 56, Right: 12);
            Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
            ItemIcon #ProjIcon1 { Anchor: (Full: 7); ShowItemTooltip: true; }
          }
          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Label #ProjName1 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #7a9cc6); Text: ""; }
            Label #ProjLine1 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
          }
          $C.@SmallSecondaryTextButton #ProjChoose1 { @Text = ""; @Anchor = Anchor(Width: 200, Height: 32, Left: 12); }
        }
        Group #Proj2 {
          LayoutMode: Left;
          Anchor: (Height: 70, Bottom: 6);
          Padding: (Horizontal: 12, Vertical: 6);
          Background: (Color: #1d2c40(0.55));
          Group {
            LayoutMode: Full;
            Anchor: (Width: 56, Height: 56, Right: 12);
            Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
            ItemIcon #ProjIcon2 { Anchor: (Full: 7); ShowItemTooltip: true; }
          }
          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Label #ProjName2 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #7a9cc6); Text: ""; }
            Label #ProjLine2 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
          }
          $C.@SmallSecondaryTextButton #ProjChoose2 { @Text = ""; @Anchor = Anchor(Width: 200, Height: 32, Left: 12); }
        }
        Group #Proj3 {
          LayoutMode: Left;
          Anchor: (Height: 70, Bottom: 6);
          Padding: (Horizontal: 12, Vertical: 6);
          Background: (Color: #1d2c40(0.55));
          Group {
            LayoutMode: Full;
            Anchor: (Width: 56, Height: 56, Right: 12);
            Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
            ItemIcon #ProjIcon3 { Anchor: (Full: 7); ShowItemTooltip: true; }
          }
          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Label #ProjName3 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #7a9cc6); Text: ""; }
            Label #ProjLine3 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
          }
          $C.@SmallSecondaryTextButton #ProjChoose3 { @Text = ""; @Anchor = Anchor(Width: 200, Height: 32, Left: 12); }
        }
        Group #Proj4 {
          LayoutMode: Left;
          Anchor: (Height: 70, Bottom: 0);
          Padding: (Horizontal: 12, Vertical: 6);
          Background: (Color: #1d2c40(0.55));
          Group {
            LayoutMode: Full;
            Anchor: (Width: 56, Height: 56, Right: 12);
            Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
            ItemIcon #ProjIcon4 { Anchor: (Full: 7); ShowItemTooltip: true; }
          }
          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Label #ProjName4 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #7a9cc6); Text: ""; }
            Label #ProjLine4 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
          }
          $C.@SmallSecondaryTextButton #ProjChoose4 { @Text = ""; @Anchor = Anchor(Width: 200, Height: 32, Left: 12); }
        }
      }
      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 12);
        Label #Rule { Style: @SmallWrap; Text: ""; FlexWeight: 1; }
        $C.@SecondaryTextButton #Back { @Text = ""; @Anchor = Anchor(Width: 240); }
      }
    }
  }
}

$C.@BackButton {}
