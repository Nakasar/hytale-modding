$C = "../../../Common.ui";

// Généré par tools/generate_workshop_ui.py (thème Trork) : ne pas modifier à la main.

@Accent = #e0773e;
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 980, Height: 520);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Trork.png", Color: #e0773e); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #e8b48a); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 14);
      Label #Intro { Anchor: (Height: 40, Bottom: 12); Style: @Body; Text: ""; }
      Group #Cards {
        LayoutMode: Left;
        FlexWeight: 1;
        Group #Spec0 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 14);
          Padding: (Horizontal: 16, Vertical: 14);
          Background: (Color: #4a2216(0.75));
          Group #SpecStripe0 { Anchor: (Height: 3, Bottom: 12); Background: (Color: #e0773e(0.6)); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 64);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 64, Height: 64, Right: 14);
              Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
              ItemIcon #SpecIcon0 { Anchor: (Full: 8); }
            }
            Label #SpecName0 { Style: (FontSize: 18, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center, Wrap: true); Text: ""; FlexWeight: 1; }
          }
          Label #SpecLine0 { Anchor: (Top: 12); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          Label #SpecState0 { Anchor: (Height: 36, Bottom: 6); Style: (FontSize: 13, RenderBold: true, TextColor: #e8c46a, Wrap: true); Text: ""; }
          $C.@SmallSecondaryTextButton #SpecChoose0 { @Text = ""; @Anchor = Anchor(Height: 32); }
        }
        Group #Spec1 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 14);
          Padding: (Horizontal: 16, Vertical: 14);
          Background: (Color: #4a2216(0.75));
          Group #SpecStripe1 { Anchor: (Height: 3, Bottom: 12); Background: (Color: #e0773e(0.6)); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 64);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 64, Height: 64, Right: 14);
              Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
              ItemIcon #SpecIcon1 { Anchor: (Full: 8); }
            }
            Label #SpecName1 { Style: (FontSize: 18, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center, Wrap: true); Text: ""; FlexWeight: 1; }
          }
          Label #SpecLine1 { Anchor: (Top: 12); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          Label #SpecState1 { Anchor: (Height: 36, Bottom: 6); Style: (FontSize: 13, RenderBold: true, TextColor: #e8c46a, Wrap: true); Text: ""; }
          $C.@SmallSecondaryTextButton #SpecChoose1 { @Text = ""; @Anchor = Anchor(Height: 32); }
        }
        Group #Spec2 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 0);
          Padding: (Horizontal: 16, Vertical: 14);
          Background: (Color: #4a2216(0.75));
          Group #SpecStripe2 { Anchor: (Height: 3, Bottom: 12); Background: (Color: #e0773e(0.6)); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 64);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 64, Height: 64, Right: 14);
              Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
              ItemIcon #SpecIcon2 { Anchor: (Full: 8); }
            }
            Label #SpecName2 { Style: (FontSize: 18, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center, Wrap: true); Text: ""; FlexWeight: 1; }
          }
          Label #SpecLine2 { Anchor: (Top: 12); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          Label #SpecState2 { Anchor: (Height: 36, Bottom: 6); Style: (FontSize: 13, RenderBold: true, TextColor: #e8c46a, Wrap: true); Text: ""; }
          $C.@SmallSecondaryTextButton #SpecChoose2 { @Text = ""; @Anchor = Anchor(Height: 32); }
        }
      }
      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 12);
        Label #Rule { Style: @SmallWrap; Text: ""; FlexWeight: 1; }
        $C.@SecondaryTextButton #Back { @Text = ""; @Anchor = Anchor(Width: 240); }
      }
    }
  }
}

$C.@BackButton {}
