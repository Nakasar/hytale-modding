$C = "../../../Common.ui";

// Généré par tools/generate_workshop_ui.py (thème Trork) : ne pas modifier à la main.

@Accent = #e0773e;
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1040, Height: 800);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Trork.png", Color: #e0773e); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #e8b48a); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 14);
      Label #Intro { Anchor: (Height: 40, Bottom: 10); Style: @Body; Text: ""; }
      Group #AnnexRow0 {
        LayoutMode: Left;
        FlexWeight: 1;
        Anchor: (Bottom: 12);
        Group #Annex0 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 12);
          Padding: (Horizontal: 14, Vertical: 10);
          Background: (Color: #4a2216(0.75));
          Group { Anchor: (Height: 3, Bottom: 8); Background: (Color: #e0773e(0.6)); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 56);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 56, Height: 56, Right: 10);
              Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
              ItemIcon #AnnexIcon0 { Anchor: (Full: 7); ShowItemTooltip: true; }
            }
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #AnnexName0 { Anchor: (Height: 22); Style: (FontSize: 16, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e0773e); Text: ""; }
              Label #AnnexRole0 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
            }
          }
          Label #AnnexState0 { Anchor: (Top: 8); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #AnnexAction0 { @Text = ""; @Anchor = Anchor(Height: 32); }
        }
        Group #Annex1 {
          LayoutMode: Top;
          FlexWeight: 1;
