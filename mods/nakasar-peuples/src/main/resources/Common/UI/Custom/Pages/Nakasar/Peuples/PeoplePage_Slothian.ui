            Padding: (Horizontal: 12, Vertical: 3);
            Background: (Color: #2b2043(0.55));
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #RowName8 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #b99be8, VerticalAlignment: Center); Text: ""; }
