            Anchor: (Height: 30, Top: 6);
            $C.@SmallSecondaryTextButton #Prev { @Text = ""; @Anchor = Anchor(Width: 110, Height: 30); }
            Label #PageLine { Style: (FontSize: 13, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; FlexWeight: 1; }
            $C.@SmallSecondaryTextButton #Next { @Text = ""; @Anchor = Anchor(Width: 110, Height: 30); }
