              Label #RowName5 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #b99be8, VerticalAlignment: Center); Text: ""; }
              Label #RowLine5 { Anchor: (Height: 22); Style: (FontSize: 13, TextColor: #96a9be, Wrap: true); Text: ""; }
            }
            $C.@SmallSecondaryTextButton #RowOrient5 { @Text = ""; @Anchor = Anchor(Width: 120, Height: 30, Left: 8, Top: 6); }
          }
          Group #Row6 {
