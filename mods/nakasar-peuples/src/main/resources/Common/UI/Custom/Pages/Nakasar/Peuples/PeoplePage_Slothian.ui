$C = "../../../Common.ui";

// Généré par tools/generate_population.py (thème Slothian) : ne pas modifier à la main.

@Accent = #b99be8;
@Section = LabelStyle(FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #d6c6f0, VerticalAlignment: Center);
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 840);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Voidtaken.png", Color: #b99be8); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #d6c6f0); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 12);
      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Group #TabBoard {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabBoardOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabBoardButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabBoardOn {
            Anchor: (Full: 0);
            Background: (Color: #b99be8);
            Visible: false;
            Label #TabBoardLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabPlots {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabPlotsOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabPlotsButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabPlotsOn {
            Anchor: (Full: 0);
            Background: (Color: #b99be8);
            Visible: false;
            Label #TabPlotsLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabAnnexes {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabAnnexesOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabAnnexesButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabAnnexesOn {
            Anchor: (Full: 0);
            Background: (Color: #b99be8);
            Visible: false;
            Label #TabAnnexesLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabWorld {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabWorldOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabWorldButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabWorldOn {
            Anchor: (Full: 0);
            Background: (Color: #b99be8);
            Visible: false;
            Label #TabWorldLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabDomain {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabDomainOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabDomainButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabDomainOn {
            Anchor: (Full: 0);
            Background: (Color: #b99be8);
            Visible: false;
            Label #TabDomainLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabPeople {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabPeopleOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: false;
            $C.@SecondaryTextButton #TabPeopleButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabPeopleOn {
            Anchor: (Full: 0);
            Background: (Color: #b99be8);
            Visible: true;
            Label #TabPeopleLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group { FlexWeight: 1; }
        Label #Clock { Anchor: (Width: 200); Style: (FontSize: 14, RenderBold: true, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center); Text: ""; }
      }
      Group { Anchor: (Height: 2, Bottom: 12); Background: (Color: #b99be8); }
      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Group #Left {
          LayoutMode: Top;
          Anchor: (Width: 590, Right: 14);
          Label #Census { Anchor: (Height: 22); Style: (FontSize: 14, RenderBold: true, TextColor: #e8c46a, VerticalAlignment: Center); Text: ""; }
          Label #ListHeader { Anchor: (Height: 22, Top: 6, Bottom: 6); Style: @Section; Text: ""; }
          Group #Row0 {
            LayoutMode: Left;
            Anchor: (Height: 48, Bottom: 4);
            Padding: (Horizontal: 12, Vertical: 3);
            Background: (Color: #2b2043(0.55));
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #RowName0 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #b99be8, VerticalAlignment: Center); Text: ""; }
              Label #RowLine0 { Anchor: (Height: 22); Style: (FontSize: 13, TextColor: #96a9be, Wrap: true); Text: ""; }
            }
            $C.@SmallSecondaryTextButton #RowOrient0 { @Text = ""; @Anchor = Anchor(Width: 120, Height: 30, Left: 8, Top: 6); }
          }
          Group #Row1 {
            LayoutMode: Left;
            Anchor: (Height: 48, Bottom: 4);
            Padding: (Horizontal: 12, Vertical: 3);
            Background: (Color: #2b2043(0.55));
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #RowName1 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #b99be8, VerticalAlignment: Center); Text: ""; }
              Label #RowLine1 { Anchor: (Height: 22); Style: (FontSize: 13, TextColor: #96a9be, Wrap: true); Text: ""; }
            }
            $C.@SmallSecondaryTextButton #RowOrient1 { @Text = ""; @Anchor = Anchor(Width: 120, Height: 30, Left: 8, Top: 6); }
          }
          Group #Row2 {
