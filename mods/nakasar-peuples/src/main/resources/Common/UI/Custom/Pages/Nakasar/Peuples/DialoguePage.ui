Group {
  LayoutMode: Center;

  Group #Panel {
    Anchor: (Width: 760, Height: 520);
    Padding: (Full: 24);
    LayoutMode: Top;

    Label #NpcName {
      Anchor: (Height: 34, Bottom: 6);
      Style: (FontSize: 24, TextColor: #e8c46a);
    }

    Label #Line {
      Anchor: (Height: 110, Bottom: 18);
      Style: (FontSize: 18, TextColor: #f2ead8, Wrap: true);
    }

    Label #Aside {
      Anchor: (Height: 44, Bottom: 6);
      Style: (FontSize: 15, TextColor: #c9b98f, Wrap: true);
    }

    TextButton #Answer0 {
      Anchor: (Height: 36, Bottom: 2);
      Text: "";
    }
    Label #Hint0 {
      Anchor: (Height: 20, Bottom: 8);
      Style: (FontSize: 13, TextColor: #a8a08c);
    }

    TextButton #Answer1 {
      Anchor: (Height: 36, Bottom: 2);
      Text: "";
    }
    Label #Hint1 {
      Anchor: (Height: 20, Bottom: 8);
      Style: (FontSize: 13, TextColor: #a8a08c);
    }

    TextButton #Answer2 {
      Anchor: (Height: 36, Bottom: 2);
      Text: "";
    }
    Label #Hint2 {
      Anchor: (Height: 20, Bottom: 8);
      Style: (FontSize: 13, TextColor: #a8a08c);
    }

    TextButton #Answer3 {
      Anchor: (Height: 36, Bottom: 2);
      Text: "";
    }
    Label #Hint3 {
      Anchor: (Height: 20, Bottom: 8);
      Style: (FontSize: 13, TextColor: #a8a08c);
    }

    TextButton #Leave {
      Anchor: (Height: 36, Width: 200);
      Text: "";
    }
  }
}
