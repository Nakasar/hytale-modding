$C = "../../../Common.ui";

// Généré par tools/generate_workshop_ui.py (thème Feran) : ne pas modifier à la main.

@Accent = #e6b552;
@Section = LabelStyle(FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #ecd29a, VerticalAlignment: Center);
@Small = LabelStyle(FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);
@Name = LabelStyle(FontSize: 15, RenderBold: true, TextColor: #e8c46a, VerticalAlignment: Center);

@Card = Group {
  Background: (Color: #0c151e(0.7));
};

@Bar = ProgressBar {
  Background: "../../../Common/ProgressBar.png";
  BarTexturePath: "Board/Bar_Feran.png";
  Value: 0;
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 840);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Feran.png", Color: #e6b552); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #ecd29a); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 12);
      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Group #TabBoard {
          LayoutMode: Full;
          Anchor: (Width: 106, Height: 38, Right: 6);
          Group #TabBoardOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabBoardButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabBoardOn {
            Anchor: (Full: 0);
            Background: (Color: #e6b552);
            Visible: false;
            Label #TabBoardLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabPlots {
          LayoutMode: Full;
          Anchor: (Width: 106, Height: 38, Right: 6);
          Group #TabPlotsOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabPlotsButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabPlotsOn {
            Anchor: (Full: 0);
            Background: (Color: #e6b552);
            Visible: false;
            Label #TabPlotsLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabAnnexes {
          LayoutMode: Full;
          Anchor: (Width: 106, Height: 38, Right: 6);
