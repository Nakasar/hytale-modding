$C = "../../../Common.ui";

// Généré par tools/generate_workshop_ui.py (thème Feran) : ne pas modifier à la main.

@Accent = #e6b552;
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1040, Height: 800);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Feran.png", Color: #e6b552); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #ecd29a); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 14);
      Label #Intro { Anchor: (Height: 22, Bottom: 10); Style: @SmallWrap; Text: ""; }
      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Anchor: (Bottom: 12);
        Group #Card0 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 12);
          Padding: (Horizontal: 14, Vertical: 10);
          Background: (Color: #4a3a17(0.75));
          Group { Anchor: (Height: 3, Bottom: 8); Background: (Color: #e6b552(0.6)); }
          Label #CardTitle0 { Anchor: (Height: 24, Bottom: 6); Style: (FontSize: 16, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e6b552); Text: ""; }
          Label #CardBody0 { Style: @Body; Text: ""; FlexWeight: 1; }
        }
        Group #Card1 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 0);
          Padding: (Horizontal: 14, Vertical: 10);
          Background: (Color: #4a3a17(0.75));
          Group { Anchor: (Height: 3, Bottom: 8); Background: (Color: #e6b552(0.6)); }
          Label #CardTitle1 { Anchor: (Height: 24, Bottom: 6); Style: (FontSize: 16, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e6b552); Text: ""; }
          Label #CardBody1 { Style: @Body; Text: ""; FlexWeight: 1; }
        }
      }
      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Anchor: (Bottom: 0);
        Group #Card2 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 12);
          Padding: (Horizontal: 14, Vertical: 10);
          Background: (Color: #4a3a17(0.75));
          Group { Anchor: (Height: 3, Bottom: 8); Background: (Color: #e6b552(0.6)); }
          Label #CardTitle2 { Anchor: (Height: 24, Bottom: 6); Style: (FontSize: 16, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e6b552); Text: ""; }
          Label #CardBody2 { Style: @Body; Text: ""; FlexWeight: 1; }
        }
        Group #Card3 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 0);
          Padding: (Horizontal: 14, Vertical: 10);
          Background: (Color: #4a3a17(0.75));
          Group { Anchor: (Height: 3, Bottom: 8); Background: (Color: #e6b552(0.6)); }
          Label #CardTitle3 { Anchor: (Height: 24, Bottom: 6); Style: (FontSize: 16, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #e6b552); Text: ""; }
          Label #CardBody3 { Style: @Body; Text: ""; FlexWeight: 1; }
        }
      }
      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 12);
        Group { FlexWeight: 1; }
        $C.@SecondaryTextButton #Back { @Text = ""; @Anchor = Anchor(Width: 240); }
      }
    }
  }
}

$C.@BackButton {}
