        Group #CalendarColumn {
          LayoutMode: Top;
          FlexWeight: 1;
          Group #Now {
            LayoutMode: Left;
            Anchor: (Height: 64, Bottom: 12);
            Background: (Color: #e8c46a(0.16));
            Group { Anchor: (Width: 4); Background: (Color: #e8c46a); }
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Padding: (Horizontal: 12, Vertical: 6);
              Label #NowTitle { Anchor: (Height: 16); Style: (FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: #e8c46a, VerticalAlignment: Center); Text: ""; }
              Label #NowText { Style: (FontSize: 14, RenderBold: true, TextColor: #f0e2b8, Wrap: true); Text: ""; FlexWeight: 1; }
            }
          }
          Label #AgendaTitle { Anchor: (Height: 22, Bottom: 6); Style: @Section; Text: ""; }
          Label #AgendaNone { Anchor: (Height: 24); Style: @SmallWrap; Text: ""; Visible: false; }
          @Card #Ag0 {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 4);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 4);
              Group #AgHere0 { Anchor: (Full: 0); Background: (Color: #e6b552); Visible: false; }
            }
            Label #AgWhen0 { Anchor: (Width: 150, Left: 10); Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #e8c46a, VerticalAlignment: Center); Text: ""; }
            Label #AgText0 { Anchor: (Right: 10); Style: (FontSize: 14, TextColor: #c9d1d9, VerticalAlignment: Center, Wrap: true); Text: ""; FlexWeight: 1; }
          }
          @Card #Ag1 {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 4);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 4);
              Group #AgHere1 { Anchor: (Full: 0); Background: (Color: #e6b552); Visible: false; }
            }
            Label #AgWhen1 { Anchor: (Width: 150, Left: 10); Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #e8c46a, VerticalAlignment: Center); Text: ""; }
            Label #AgText1 { Anchor: (Right: 10); Style: (FontSize: 14, TextColor: #c9d1d9, VerticalAlignment: Center, Wrap: true); Text: ""; FlexWeight: 1; }
          }
          @Card #Ag2 {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 4);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 4);
              Group #AgHere2 { Anchor: (Full: 0); Background: (Color: #e6b552); Visible: false; }
