              LayoutMode: Full;
              Anchor: (Width: 84, Height: 100, Right: 14);
              Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
              ItemIcon #ArmsIcon { Anchor: (Full: 8); ShowItemTooltip: true; }
            }
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #ArmsName { Anchor: (Height: 22); Style: (FontSize: 16, RenderBold: true, TextColor: #e8c46a); Text: ""; }
              Group {
                LayoutMode: Left;
                Anchor: (Height: 30, Top: 6);
                $C.@SmallSecondaryTextButton #ColourPrev { @Text = ""; @Anchor = Anchor(Width: 100, Height: 30, Right: 6); }
                $C.@SmallSecondaryTextButton #ColourNext { @Text = ""; @Anchor = Anchor(Width: 100, Height: 30, Right: 14); }
                $C.@SmallSecondaryTextButton #EmblemPrev { @Text = ""; @Anchor = Anchor(Width: 100, Height: 30, Right: 6); }
                $C.@SmallSecondaryTextButton #EmblemNext { @Text = ""; @Anchor = Anchor(Width: 100, Height: 30); }
              }
              Label #ArmsHint { Anchor: (Top: 6); Style: @SmallWrap; Text: ""; FlexWeight: 1; }
            }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 30);
            Group { FlexWeight: 1; }
            $C.@SmallSecondaryTextButton #ArmsApply { @Text = ""; @Anchor = Anchor(Width: 220, Height: 30); }
          }
        }
        Group {
