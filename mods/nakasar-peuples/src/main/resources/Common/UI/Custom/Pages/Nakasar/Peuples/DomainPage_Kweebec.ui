              Label #RowOwner0 { Anchor: (Width: 260); Style: (FontSize: 14, RenderBold: true, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center); Text: ""; }
            }
            Label #RowState0 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
          }
          $C.@SmallSecondaryTextButton #RowEmbassy0 { @Text = ""; @Anchor = Anchor(Width: 170, Height: 32, Left: 12); }
          $C.@SmallSecondaryTextButton #RowExpedition0 { @Text = ""; @Anchor = Anchor(Width: 170, Height: 32, Left: 8); }
        }
        Group #Row1 {
