          Label #ColoursLine { Anchor: (Top: 6, Height: 40); Style: @Body; Text: ""; }
          Label #BannersLine { Anchor: (Top: 4, Height: 36); Style: @SmallWrap; Text: ""; }
          Group { FlexWeight: 1; }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 30);
            $C.@SmallSecondaryTextButton #ColoursToggle { @Text = ""; @Anchor = Anchor(Width: 170, Height: 30, Right: 8); }
            $C.@SmallSecondaryTextButton #Embroider { @Text = ""; @Anchor = Anchor(Width: 170, Height: 30); }
          }
        }
