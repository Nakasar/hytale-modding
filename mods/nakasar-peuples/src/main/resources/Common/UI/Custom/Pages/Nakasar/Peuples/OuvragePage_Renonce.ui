$C = "../../../Common.ui";

// Généré par tools/generate_workshop_ui.py (thème Renonce) : ne pas modifier à la main.

@Accent = #8fd0ea;
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);
@Count = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 840);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Outlander.png", Color: #8fd0ea); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #bfe2ee); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 12);
      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Group #TabBoard {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabBoardOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabBoardButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabBoardOn {
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Label #TabBoardLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabPlots {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabPlotsOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabPlotsButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabPlotsOn {
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Label #TabPlotsLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabAnnexes {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabAnnexesOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            $C.@SecondaryTextButton #TabAnnexesButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabAnnexesOn {
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Label #TabAnnexesLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabWorks {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
          Group #TabWorksOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: false;
            $C.@SecondaryTextButton #TabWorksButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          }
          Group #TabWorksOn {
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: true;
            Label #TabWorksLabel { Anchor: (Full: 0); Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #TabWorld {
          LayoutMode: Full;
          Anchor: (Width: 128, Height: 38, Right: 6);
