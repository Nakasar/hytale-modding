          FlexWeight: 1;
          Anchor: (Right: 10);
          Padding: (Horizontal: 12, Vertical: 8);
          Background: (Color: #173246(0.75));
          Group { Anchor: (Height: 3, Bottom: 6); Background: (Color: #8fd0ea(0.6)); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 46);
            Group {
              LayoutMode: Full;
              Anchor: (Width: 42, Height: 42, Right: 8);
              Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
              ItemIcon #TypeIcon0 { Anchor: (Full: 5); ShowItemTooltip: true; }
            }
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #TypeName0 { Anchor: (Height: 20); Style: (FontSize: 14, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #8fd0ea); Text: ""; }
              Label #TypeCount0 { Anchor: (Height: 18); Style: (FontSize: 13, RenderBold: true, TextColor: #e8c46a); Text: ""; }
            }
          }
          Label #TypeRole0 { Anchor: (Height: 54, Top: 2); Style: @SmallWrap; Text: ""; }
          Group #TypeMats0 {
            LayoutMode: Left;
            Anchor: (Height: 50, Top: 2);
            Group #TypeMat0 {
              LayoutMode: Top;
              Anchor: (Width: 46, Right: 6);
