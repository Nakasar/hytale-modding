                LayoutMode: Full;
                Anchor: (Width: 34, Height: 34, Left: 6);
                Group #TypeMatSlot0 { Anchor: (Full: 0); Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24); }
                Group #TypeMatOk0 { Anchor: (Full: 0); Background: (TexturePath: "../../../Common/IngredientSlotValid.png", Border: 24); Visible: false; }
                ItemIcon #TypeMatIcon0 { Anchor: (Full: 3); ShowItemTooltip: true; }
              }
              Label #TypeMatCount0 { Anchor: (Height: 14, Top: 1); Style: @Count; Text: ""; }
            }
            Group #TypeMat1 {
