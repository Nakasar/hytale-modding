          Label #AnnexState2 { Anchor: (Top: 8); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #AnnexAction2 { @Text = ""; @Anchor = Anchor(Height: 32); }
        }
      }
      Group #AnnexRow1 {
        LayoutMode: Left;
        FlexWeight: 1;
        Anchor: (Bottom: 0);
        Group #Annex3 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 12);
          Padding: (Horizontal: 14, Vertical: 10);
          Background: (Color: #2d4a26(0.75));
