          Group { FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #AnnexAction4 { @Text = ""; @Anchor = Anchor(Height: 32); }
        }
        Group #Annex5 {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 0);
          Padding: (Horizontal: 14, Vertical: 10);
          Background: (Color: #2d4a26(0.75));
