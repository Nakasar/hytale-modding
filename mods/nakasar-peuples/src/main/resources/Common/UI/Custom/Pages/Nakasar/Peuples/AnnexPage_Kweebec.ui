            }
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #AnnexName0 { Anchor: (Height: 22); Style: (FontSize: 16, FontName: "Secondary", RenderBold: true, RenderUppercase: true, TextColor: #9ed36a); Text: ""; }
              Label #AnnexRole0 { Anchor: (Top: 2); Style: @SmallWrap; Text: ""; }
            }
          }
          Label #AnnexState0 { Anchor: (Top: 8); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
