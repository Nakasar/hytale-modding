            }
          }
          Label #AnnexState3 { Anchor: (Top: 8); Style: @Body; Text: ""; }
          Group { FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #AnnexAction3 { @Text = ""; @Anchor = Anchor(Height: 32); }
        }
        Group #Annex4 {
          LayoutMode: Top;
